---
// 空中花园 WIKI：右侧液态玻璃档案层
import { wikiEntries } from '../data/wikiEntries';
---

<div class="wiki" data-wiki>
  <svg class="wiki-filter-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="wiki-liquid" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.004 0.009" numOctaves="1" seed="7" result="noise"></feTurbulence>
      <feGaussianBlur in="noise" stdDeviation="1.2" result="soft"></feGaussianBlur>
      <feDisplacementMap
        in="SourceGraphic"
        in2="soft"
        scale="26"
        xChannelSelector="R"
        yChannelSelector="G"
      ></feDisplacementMap>
    </filter>
  </svg>

  <button
    class="wiki-tab"
    type="button"
    data-wiki-toggle
    aria-expanded="false"
    aria-controls="wiki-panel"
    aria-label="打开 WIKI 世界观"
  >
    <span class="wiki-tab-arrow" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.4 4.2 6.6 10l5.8 5.8"></path>
        <path d="M6.9 10h8.6" opacity="0.55"></path>
      </svg>
    </span>
    <span class="wiki-tab-word" aria-hidden="true"><i>W</i><i>I</i><i>K</i><i>I</i></span>
  </button>

  <section
    class="wiki-panel"
    id="wiki-panel"
    data-wiki-panel
    role="region"
    aria-label="世界观：空中花园"
    aria-hidden="true"
    inert
  >
    <div class="wiki-refract" aria-hidden="true"></div>
    <div class="wiki-scroll" data-wiki-scroll>
      <div class="wiki-inner">
        <header class="wiki-head">
          <div class="head-text">
            <p class="wiki-crumb">世界观<span aria-hidden="true">/</span></p>
            <h2>空中花园</h2>
            <p class="wiki-latin">Garden of Eden</p>
          </div>
          <figure class="wiki-plate">
            <img src="/media/aerial-garden.png" alt="伊甸级·空中花园：悬于地球轨道上的巨型空间站" width="720" height="360" loading="lazy" />
            <figcaption>伊甸级 · 空中花园</figcaption>
          </figure>
        </header>

        <div class="wiki-body">
          <div class="wiki-col">
            <figure class="wiki-oath">
              <blockquote>愿每一位重返地球的人类之子，平安！</blockquote>
            </figure>

            <section class="wiki-anthem">
              <h3>
                <span class="anthem-school">法奥斯军事学院校歌</span>
                <span class="anthem-title">《长路归航》</span>
              </h3>
              <div class="video-frame">
                <iframe
                  src="https://player.bilibili.com/player.html?bvid=BV1iu41157u6&page=1&high_quality=1&danmaku=1&autoplay=0&isOutside=true"
                  title="法奥斯军事学院校歌《长路归航》"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  scrolling="no"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
                <button class="video-cover" type="button" data-video-cover>
                  <span class="cover-play" aria-hidden="true">
                    <svg viewBox="0 0 12 14" width="12" height="14">
                      <path d="M0.8 0.9v12.2L11.2 7z" fill="currentColor"></path>
                    </svg>
                  </span>
                  <span class="cover-title">长路归航</span>
                  <span class="cover-note">开始播放前，背景音乐将暂停</span>
                </button>
              </div>
              <p class="video-note">穹顶之下，长路自有归航。</p>
            </section>
          </div>

          <div class="wiki-col">
            <section class="wiki-structure">
              <header class="struct-head">
                <h3>建制</h3>
                <p class="struct-sub">空中花园的组织与机构 · 点击名称查阅档案</p>
              </header>

              <div class="ledger">
                <div class="ledger-row">
                  <p class="ledger-key">政治机构</p>
                  <div class="ledger-val">
                    <p class="ledger-lead">
                      <button class="entry-link" type="button" data-wiki-entry="council">联合世界政府议会</button>
                    </p>
                    <ul class="tag-row">
                      <li>行政院</li>
                      <li><button class="entry-link" type="button" data-wiki-entry="oversight">监察院</button></li>
                      <li>司法庭</li>
                      <li><button class="entry-link" type="button" data-wiki-entry="foreign">外交院</button></li>
                    </ul>
                  </div>
                </div>

                <div class="ledger-row">
                  <p class="ledger-key">军事机构</p>
                  <div class="ledger-val">
                    <p class="ledger-lead">
                      <button class="entry-link" type="button" data-wiki-entry="military">空中花园军部</button>
                    </p>
                    <ul class="tag-row">
                      <li>司令部</li>
                      <li><button class="entry-link" type="button" data-wiki-entry="staff">参谋部</button></li>
                      <li><button class="entry-link" type="button" data-wiki-entry="fos">法奥斯军事学院</button></li>
                    </ul>
                    <div class="ledger-branch">
                      <p class="branch-name">
                        <button class="entry-link" type="button" data-wiki-entry="taskforce">执行部队</button>
                      </p>
                      <ul class="tag-row">
                        <li>精英小队</li>
                        <li>斥候小队</li>
                        <li>总司令直属小队</li>
                        <li>常规作战小队</li>
                      </ul>
                    </div>
                    <ul class="tag-row">
                      <li><button class="entry-link" type="button" data-wiki-entry="engineering">工程部队</button></li>
                      <li><button class="entry-link" type="button" data-wiki-entry="purge">清理部队</button></li>
                      <li><button class="entry-link" type="button" data-wiki-entry="support">支援部队</button></li>
                      <li>战略外交科</li>
                    </ul>
                  </div>
                </div>

                <div class="ledger-row">
                  <p class="ledger-key">科研单位</p>
                  <div class="ledger-val">
                    <p class="ledger-lead">
                      <button class="entry-link" type="button" data-wiki-entry="science">科学理事会</button>
                    </p>
                    <ul class="tag-row">
                      <li>科学理事会一部</li>
                      <li>科学理事会二部</li>
                      <li>伦理委员会</li>
                      <li>安全审查部</li>
                    </ul>
                  </div>
                </div>

                <div class="ledger-row">
                  <p class="ledger-key">医疗单位</p>
                  <div class="ledger-val">
                    <p class="ledger-lead">
                      <button class="entry-link" type="button" data-wiki-entry="life">生命之星</button>
                    </p>
                  </div>
                </div>

                <div class="ledger-row">
                  <p class="ledger-key">其它组织</p>
                  <div class="ledger-val">
                    <ul class="tag-row">
                      <li><button class="entry-link" type="button" data-wiki-entry="arts">艺术协会</button></li>
                      <li><button class="entry-link" type="button" data-wiki-entry="guild">寰宇技师工会</button></li>
                      <li>诺曼矿业集团</li>
                      <li><button class="entry-link" type="button" data-wiki-entry="moon">月面基地</button></li>
                      <li>商业理事会</li>
                      <li><button class="entry-link" type="button" data-wiki-entry="tower">“高塔”</button></li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>

    <div class="wiki-sub" data-wiki-sub role="region" aria-label="机构档案" aria-hidden="true" inert>
      <div class="sub-top">
        <button class="sub-back" type="button" data-wiki-back>
          <svg viewBox="0 0 18 18" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.2 9H3.8"></path>
            <path d="M8.4 3.6 3 9l5.4 5.4"></path>
          </svg>
          <span>返回建制</span>
        </button>
        <p class="sub-crumb">
          <span>世界观</span><i aria-hidden="true">/</i><span>空中花园</span><i aria-hidden="true">/</i><b data-sub-crumb>档案</b>
        </p>
      </div>

      <div class="sub-scroll" data-sub-scroll>
        <div class="sub-inner">
          {wikiEntries.map((entry) => (
            <article class="sub-entry" data-entry-id={entry.id} aria-hidden="true" inert>
              <header class="entry-head">
                {entry.emblem ? (
                  <span class={`entry-emblem${entry.id === 'moon' ? ' entry-emblem--photo' : ''}`}>
                    <img src={entry.emblem} alt={`${entry.name}徽记`} width="128" height="128" loading="lazy" />
                  </span>
                ) : (
                  <span class="entry-emblem entry-emblem--seal" aria-hidden="true">{entry.crumb.charAt(0)}</span>
                )}
                <div class="entry-titles">
                  <p class="entry-kind">{entry.kind}</p>
                  <h3>{entry.name}</h3>
                  <p class="entry-latin">{entry.latin}</p>
                </div>
                <p class="entry-tagline">{entry.tagline}</p>
              </header>

              <div class="entry-body">
                <div class="entry-main">
                  <div class="entry-lead">
                    {entry.lead.map((paragraph) => <p>{paragraph}</p>)}
                  </div>

                  {entry.meta && (
                    <dl class="entry-meta">
                      {entry.meta.map((item) => (
                        <div>
                          <dt>{item.label}</dt>
                          <dd>{item.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {entry.sections.map((section) => (
                    <section class="entry-section">
                      <h4>{section.title}</h4>
                      {section.paras?.map((paragraph) => <p>{paragraph}</p>)}
                      {section.items && (
                        <ul class="entry-list">
                          {section.items.map((item) => <li>{item}</li>)}
                        </ul>
                      )}
                      {section.quote && <blockquote class="entry-quote">{section.quote}</blockquote>}
                      {section.links && (
                        <div class="entry-links">
                          {section.links.map((link) => (
                            <button class="entry-jump" type="button" data-wiki-entry={link.id}>
                              {link.label}<span aria-hidden="true">→</span>
                            </button>
                          ))}
                        </div>
                      )}
                      {section.squads && (
                        <div class="squad-grid">
                          {section.squads.map((squad) => (
                            <article class="squad-card">
                              {squad.img ? (
                                <img src={squad.img} alt={`${squad.name}徽记`} width="72" height="72" loading="lazy" />
                              ) : (
                                <span class="squad-glyph" aria-hidden="true">{squad.name.charAt(0)}</span>
                              )}
                              <div>
                                <h5>{squad.name}</h5>
                                <p>{squad.desc}</p>
                                {squad.members && <p class="squad-members">{squad.members}</p>}
                              </div>
                              {squad.portraits && (
                                <ul class="squad-figures">
                                  {squad.portraits.map((person) => (
                                    <li>
                                      <img src={person.img} alt={person.name} width="40" height="44" loading="lazy" />
                                      <span>{person.name}</span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </article>
                          ))}
                        </div>
                      )}
                    </section>
                  ))}
                </div>

                <aside class="entry-side">
                  {entry.figures && (
                    <section class="entry-figures">
                      <h4>相关人物</h4>
                      <ul>
                        {entry.figures.map((figure) => (
                          <li>
                            {figure.img ? (
                              <img src={figure.img} alt={figure.name} width="56" height="60" loading="lazy" />
                            ) : (
                              <span class="figure-glyph" aria-hidden="true">{figure.name.charAt(0)}</span>
                            )}
                            <div>
                              <p>{figure.name}</p>
                              <span>{figure.role}</span>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}

                  {entry.related && (
                    <nav class="entry-related" aria-label="相关档案">
                      <h4>相关档案</h4>
                      {entry.related.map((item) => (
                        <button class="entry-jump" type="button" data-wiki-entry={item.id}>
                          {item.label}<span aria-hidden="true">→</span>
                        </button>
                      ))}
                    </nav>
                  )}
                </aside>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { initWiki } from '../scripts/wiki';

  initWiki();
</script>

<style>
  .wiki {
    position: relative;
  }

  .wiki-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ---- 右缘的 WIKI 标签 ---- */
  .wiki-tab {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 7;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 52px;
    padding: 17px 0 21px;
    border: 1px solid rgba(236, 246, 252, 0.24);
    border-right: 0;
    border-radius: 14px 0 0 14px;
    color: var(--mist-2);
    background:
      linear-gradient(90deg, rgba(13, 27, 44, 0.44), rgba(6, 14, 24, 0.22)),
      radial-gradient(120% 80% at 0% 0%, rgba(159, 220, 238, 0.18), transparent 62%);
    -webkit-backdrop-filter: blur(8px) saturate(1.8) brightness(1.08);
    backdrop-filter: blur(8px) saturate(1.8) brightness(1.08);
    box-shadow:
      -16px 0 46px rgba(2, 6, 12, 0.34),
      inset 0 1px 1px rgba(255, 255, 255, 0.4),
      inset 1px 0 1px rgba(255, 255, 255, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-50%);
    transition:
      opacity 1.2s ease 0.7s,
      visibility 1.2s ease 0.7s,
      color 0.45s ease,
      background 0.45s ease,
      box-shadow 0.45s ease;
  }

  :global(.stage.is-entered) .wiki-tab {
    opacity: 1;
    visibility: visible;
  }

  .wiki-tab:hover,
  .wiki-tab:focus-visible {
    color: var(--mist);
    background:
      linear-gradient(90deg, rgba(20, 42, 64, 0.54), rgba(8, 18, 30, 0.3)),
      radial-gradient(120% 80% at 0% 0%, rgba(159, 220, 238, 0.3), transparent 62%);
    box-shadow:
      -18px 0 54px rgba(6, 18, 30, 0.42),
      0 0 34px rgba(140, 208, 232, 0.14),
      inset 0 1px 1px rgba(255, 255, 255, 0.5),
      inset 1px 0 1px rgba(255, 255, 255, 0.24);
  }

  .wiki-tab-arrow {
    display: grid;
    place-items: center;
    color: var(--glow);
    transition: transform 0.6s cubic-bezier(0.16, 0.72, 0.22, 1), color 0.45s ease;
  }

  .wiki-tab-arrow svg {
    display: block;
  }

  .wiki.is-open .wiki-tab-arrow {
    transform: rotate(180deg);
    color: var(--mist);
  }

  .wiki-tab-word {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    font-family: var(--font-ui);
    font-size: 0.58rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.06em;
    opacity: 0.9;
  }

  .wiki-tab-word i {
    font-style: normal;
  }

  .wiki.is-open .wiki-tab {
    border-color: rgba(220, 238, 248, 0.3);
    box-shadow:
      -20px 0 58px rgba(6, 18, 30, 0.46),
      0 0 40px rgba(140, 208, 232, 0.16),
      inset 0 1px 0 rgba(236, 246, 252, 0.22);
  }

  /* ---- 液态玻璃面板 ---- */
  .wiki-panel {
    position: fixed;
    top: clamp(76px, 10.5vh, 112px);
    right: clamp(64px, 6vw, 88px);
    bottom: clamp(26px, 4.6vh, 48px);
    left: clamp(16px, 3.4vw, 56px);
    z-index: 6;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(236, 246, 252, 0.24);
    border-radius: 28px;
    background:
      radial-gradient(120% 100% at 8% 0%, rgba(159, 220, 238, 0.1), rgba(159, 220, 238, 0) 55%),
      radial-gradient(85% 75% at 100% 100%, rgba(227, 206, 162, 0.055), rgba(227, 206, 162, 0) 62%),
      linear-gradient(180deg, rgba(226, 241, 250, 0.05), rgba(4, 10, 18, 0.05)),
      rgba(6, 15, 26, 0.26);
    -webkit-backdrop-filter: blur(10px) saturate(1.9) brightness(1.06);
    backdrop-filter: blur(10px) saturate(1.9) brightness(1.06);
    box-shadow:
      0 42px 120px rgba(1, 4, 9, 0.52),
      inset 0 1px 1px rgba(255, 255, 255, 0.5),
      inset 0 -1px 1px rgba(255, 255, 255, 0.2),
      inset 1px 0 1px rgba(255, 255, 255, 0.16),
      inset -1px 0 1px rgba(255, 255, 255, 0.16);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(3.2vw) scale(0.988);
    transition:
      opacity 0.7s ease,
      transform 0.9s cubic-bezier(0.16, 0.72, 0.22, 1),
      visibility 0.9s;
  }

  .wiki.is-open .wiki-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  /* 折射环：只让玻璃边缘弯曲背景，中间保持通透 */
  .wiki-refract {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 14px;
    border-radius: inherit;
    pointer-events: none;
    -webkit-backdrop-filter: blur(3px) saturate(1.7) brightness(1.12);
    backdrop-filter: blur(3px) saturate(1.7) brightness(1.12);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  @supports (backdrop-filter: url('#wiki-liquid')) {
    .wiki-refract {
      backdrop-filter: blur(2px) saturate(1.7) brightness(1.12) url('#wiki-liquid');
    }
  }

  /* 顶部的受光高光与斜向光泽 */
  .wiki-panel::before,
  .wiki-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .wiki-panel::before {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 9%),
      radial-gradient(58% 34% at 18% 0%, rgba(255, 255, 255, 0.1), transparent 72%);
    opacity: 0.85;
  }

  .wiki-panel::after {
    background: linear-gradient(
      132deg,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0.03) 22%,
      transparent 46%
    );
    mix-blend-mode: screen;
  }

  .wiki-scroll {
    position: relative;
    z-index: 1;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: clamp(26px, 4vh, 50px) clamp(22px, 4vw, 58px) clamp(32px, 5vh, 62px);
    scrollbar-width: thin;
    scrollbar-color: rgba(198, 226, 240, 0.26) transparent;
    transition:
      opacity 0.55s ease,
      transform 0.85s cubic-bezier(0.16, 0.72, 0.22, 1);
  }

  .wiki-scroll::-webkit-scrollbar,
  .sub-scroll::-webkit-scrollbar {
    width: 5px;
  }

  .wiki-scroll::-webkit-scrollbar-track,
  .sub-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .wiki-scroll::-webkit-scrollbar-thumb,
  .sub-scroll::-webkit-scrollbar-thumb {
    background: rgba(198, 226, 240, 0.24);
    border-radius: 99px;
  }

  .wiki-scroll::-webkit-scrollbar-thumb:hover,
  .sub-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(198, 226, 240, 0.4);
  }

  .wiki-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* ---- 标题与影像 ---- */
  .wiki-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 400px);
    align-items: end;
    gap: clamp(20px, 3vw, 44px);
    padding-bottom: clamp(20px, 3vh, 30px);
    border-bottom: 1px solid var(--line-soft);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.9s ease, transform 1s cubic-bezier(0.16, 0.72, 0.22, 1);
  }

  .head-text {
    min-width: 0;
  }

  .wiki-plate {
    margin: 0;
    display: grid;
    gap: 9px;
    min-width: 0;
  }

  .wiki-plate img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border: 1px solid rgba(236, 246, 252, 0.2);
    border-radius: 8px;
    box-shadow:
      0 16px 44px rgba(1, 4, 9, 0.46),
      0 0 0 1px rgba(159, 220, 238, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    filter: saturate(1.06) contrast(1.03);
  }

  .wiki-plate figcaption {
    text-align: right;
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--gold);
    opacity: 0.8;
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.6);
  }

  .wiki-crumb {
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 300;
    letter-spacing: 0.32em;
    color: var(--gold);
    opacity: 0.9;
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.65);
  }

  .wiki-crumb span {
    margin-left: 6px;
    opacity: 0.55;
  }

  .wiki-head h2 {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(2.2rem, 4.4vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: 0.16em;
    margin-left: -0.06em;
    color: var(--mist);
    text-shadow:
      0 1px 18px rgba(2, 6, 12, 0.55),
      0 0 46px rgba(140, 208, 232, 0.28),
      0 0 120px rgba(120, 190, 220, 0.14);
  }

  .wiki-latin {
    margin-top: 8px;
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.88rem;
    letter-spacing: 0.26em;
    color: var(--mist-2);
    opacity: 0.82;
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.6);
  }

  .wiki-body {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 4.6vw, 68px);
    margin-top: clamp(24px, 3.6vh, 38px);
    align-items: start;
  }

  .wiki-col {
    min-width: 0;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1s ease, transform 1.1s cubic-bezier(0.16, 0.72, 0.22, 1);
  }

  .wiki.is-open .wiki-head,
  .wiki.is-open .wiki-col {
    opacity: 1;
    transform: none;
  }

  .wiki.is-open .wiki-head {
    transition-delay: 0.12s;
  }

  .wiki.is-open .wiki-col:first-of-type {
    transition-delay: 0.24s;
  }

  .wiki.is-open .wiki-col:last-of-type {
    transition-delay: 0.34s;
  }

  /* ---- 誓辞 ---- */
  .wiki-oath {
    margin: 0;
    padding: clamp(18px, 2.4vw, 28px) 0 clamp(18px, 2.4vw, 28px) clamp(18px, 2.2vw, 28px);
    border-left: 1px solid rgba(227, 206, 162, 0.45);
    background: linear-gradient(90deg, rgba(227, 206, 162, 0.055), transparent 72%);
  }

  .wiki-oath blockquote {
    font-family: 'Ma Shan Zheng', var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.35rem);
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: #f1e7d0;
    text-shadow:
      0 2px 18px rgba(2, 6, 12, 0.6),
      0 0 34px rgba(227, 206, 162, 0.22);
  }

  /* ---- 校歌 ---- */
  .wiki-anthem {
    margin-top: clamp(30px, 4.4vh, 46px);
  }

  .wiki-anthem h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
  }

  .anthem-school {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    color: var(--mist-2);
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.62);
  }

  .anthem-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.22rem;
    letter-spacing: 0.12em;
    color: var(--mist);
    text-shadow: 0 1px 16px rgba(2, 6, 12, 0.62);
  }

  .video-frame {
    position: relative;
    margin-top: 16px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(220, 238, 248, 0.16);
    border-radius: 6px;
    background: rgba(3, 8, 16, 0.6);
    box-shadow:
      0 20px 54px rgba(1, 4, 9, 0.5),
      inset 0 1px 0 rgba(236, 246, 252, 0.08);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 11px;
    width: 100%;
    padding: 18px;
    color: var(--mist);
    background:
      radial-gradient(80% 92% at 50% 38%, rgba(14, 30, 48, 0.5), rgba(3, 8, 16, 0.88) 78%),
      linear-gradient(180deg, rgba(159, 220, 238, 0.06), transparent 58%);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .video-cover::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid rgba(227, 206, 162, 0.16);
    border-radius: 3px;
    pointer-events: none;
    transition: border-color 0.5s ease;
  }

  .video-cover:hover::before,
  .video-cover:focus-visible::before {
    border-color: rgba(227, 206, 162, 0.4);
  }

  .cover-play {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    padding-left: 3px;
    border: 1px solid rgba(230, 240, 247, 0.42);
    border-radius: 50%;
    color: var(--mist);
    background: rgba(8, 18, 30, 0.3);
    transition:
      border-color 0.45s ease,
      background 0.45s ease,
      box-shadow 0.45s ease;
  }

  .video-cover:hover .cover-play,
  .video-cover:focus-visible .cover-play {
    border-color: rgba(230, 240, 247, 0.82);
    background: rgba(159, 220, 238, 0.09);
    box-shadow: 0 0 38px rgba(140, 208, 232, 0.26);
  }

  .cover-title {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.36em;
    text-indent: 0.36em;
    text-shadow: 0 2px 24px rgba(2, 6, 12, 0.8);
  }

  .cover-note {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--mist-2);
    opacity: 0.72;
  }

  .wiki.is-video .video-cover {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .video-note {
    margin-top: 11px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--mist-3);
  }

  /* ---- 建制档案 ---- */
  .struct-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--line-soft);
  }

  .struct-head h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.02rem;
    letter-spacing: 0.3em;
    color: var(--mist);
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.6);
  }

  .struct-sub {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--mist-3);
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.55);
  }

  .ledger {
    border-top: 0;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    gap: clamp(14px, 1.8vw, 28px);
    padding: 17px 0 18px;
    border-bottom: 1px solid var(--line-soft);
  }

  .ledger-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .ledger-key {
    padding-top: 3px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    opacity: 0.92;
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.6);
  }

  .ledger-val {
    display: grid;
    gap: 9px;
    min-width: 0;
  }

  .ledger-lead {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: 0.1em;
    color: var(--mist);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.58);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-row li {
    padding: 3px 10px;
    border: 1px solid rgba(198, 226, 240, 0.18);
    border-radius: 2px;
    background: rgba(230, 240, 247, 0.06);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    line-height: 1.65;
    color: var(--mist-2);
    text-shadow: 0 1px 10px rgba(2, 6, 12, 0.5);
  }

  .ledger-branch {
    display: grid;
    gap: 8px;
    margin: 3px 0 3px 1px;
    padding-left: 14px;
    border-left: 1px solid rgba(227, 206, 162, 0.26);
  }

  .branch-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    color: var(--mist);
    opacity: 0.92;
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.55);
  }

  /* ---- 建制中的可查阅名称 ---- */
  .entry-link {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px dotted rgba(227, 206, 162, 0.36);
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      color 0.4s ease,
      border-color 0.4s ease,
      text-shadow 0.4s ease;
  }

  .entry-link:hover,
  .entry-link:focus-visible {
    color: #fff;
    border-bottom-color: rgba(227, 206, 162, 0.86);
    text-shadow: 0 0 24px rgba(159, 220, 238, 0.5);
  }

  .entry-link:focus-visible {
    outline: 1px solid rgba(159, 220, 238, 0.55);
    outline-offset: 3px;
  }

  /* ---- 液态玻璃内的子档案 ---- */
  .wiki-sub {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: inherit;
    background:
      radial-gradient(110% 80% at 92% 0%, rgba(159, 220, 238, 0.045), transparent 58%),
      linear-gradient(180deg, rgba(6, 15, 26, 0.12), rgba(4, 10, 18, 0.2));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(2.4%);
    transition:
      opacity 0.55s ease,
      transform 0.85s cubic-bezier(0.16, 0.72, 0.22, 1),
      visibility 0.85s;
  }

  .wiki.is-sub .wiki-sub {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .wiki.is-sub .wiki-scroll {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-2.4%);
  }

  .sub-top {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: clamp(16px, 2.4vh, 24px) clamp(20px, 4vw, 58px) clamp(13px, 1.9vh, 18px);
    border-bottom: 1px solid var(--line-soft);
  }

  .sub-back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 16px 8px 12px;
    border: 1px solid rgba(236, 246, 252, 0.18);
    border-radius: 99px;
    background: rgba(230, 240, 247, 0.05);
    color: var(--mist-2);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    cursor: pointer;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition:
      color 0.4s ease,
      border-color 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .sub-back:hover,
  .sub-back:focus-visible {
    color: var(--mist);
    border-color: rgba(227, 206, 162, 0.48);
    background: rgba(227, 206, 162, 0.08);
    box-shadow: 0 0 32px rgba(159, 220, 238, 0.12);
  }

  .sub-back:focus-visible {
    outline: 1px solid rgba(159, 220, 238, 0.6);
    outline-offset: 3px;
  }

  .sub-back svg {
    color: var(--glow);
    transition: transform 0.4s cubic-bezier(0.16, 0.72, 0.22, 1);
  }

  .sub-back:hover svg {
    transform: translateX(-3px);
  }

  .sub-crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--mist-3);
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.55);
  }

  .sub-crumb i {
    font-style: normal;
    opacity: 0.36;
  }

  .sub-crumb b {
    font-weight: 400;
    color: var(--gold);
    opacity: 0.92;
  }

  .sub-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: clamp(22px, 3.6vh, 42px) clamp(20px, 4vw, 58px) clamp(30px, 5vh, 58px);
    scrollbar-width: thin;
    scrollbar-color: rgba(198, 226, 240, 0.26) transparent;
  }

  .sub-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .sub-entry {
    display: none;
  }

  .sub-entry.is-active {
    display: block;
    animation: entry-in 0.7s cubic-bezier(0.16, 0.72, 0.22, 1) both;
  }

  @keyframes entry-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .entry-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 8px clamp(18px, 2.4vw, 30px);
    padding-bottom: clamp(18px, 2.8vh, 26px);
    border-bottom: 1px solid var(--line-soft);
  }

  .entry-emblem {
    display: grid;
    place-items: center;
    width: clamp(74px, 8vw, 104px);
    height: clamp(74px, 8vw, 104px);
    border: 1px solid rgba(227, 206, 162, 0.24);
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, rgba(159, 220, 238, 0.1), rgba(4, 10, 18, 0.24) 72%);
    box-shadow:
      inset 0 0 28px rgba(159, 220, 238, 0.09),
      0 14px 40px rgba(1, 4, 9, 0.42);
  }

  .entry-emblem img {
    width: 100%;
    height: 100%;
    padding: 7px;
    object-fit: contain;
    filter: invert(1) brightness(1.04) drop-shadow(0 6px 16px rgba(0, 0, 0, 0.45));
    opacity: 0.94;
  }

  .entry-emblem--photo img {
    padding: 0;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.03);
    opacity: 1;
  }

  .entry-emblem--seal {
    font-family: 'Ma Shan Zheng', var(--font-display);
    font-size: clamp(2rem, 4vw, 2.9rem);
    color: rgba(227, 206, 162, 0.78);
    text-shadow: 0 0 26px rgba(227, 206, 162, 0.28);
  }

  .entry-titles {
    min-width: 0;
  }

  .entry-kind {
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    color: var(--gold);
    opacity: 0.92;
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.6);
  }

  .entry-titles h3 {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    line-height: 1.2;
    letter-spacing: 0.12em;
    color: var(--mist);
    text-shadow:
      0 1px 18px rgba(2, 6, 12, 0.55),
      0 0 42px rgba(140, 208, 232, 0.22);
  }

  .entry-latin {
    margin-top: 6px;
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--mist-3);
  }

  .entry-tagline {
    grid-column: 2;
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: 0.82rem;
    line-height: 1.75;
    letter-spacing: 0.06em;
    color: var(--mist-2);
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.55);
  }

  .entry-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, 268px);
    gap: clamp(26px, 4vw, 56px);
    margin-top: clamp(22px, 3.2vh, 34px);
    align-items: start;
  }

  .entry-main {
    min-width: 0;
  }

  .entry-lead {
    display: grid;
    gap: 13px;
    max-width: 74ch;
  }

  .entry-lead p {
    font-size: 0.88rem;
    line-height: 2;
    color: var(--mist-2);
    text-shadow: 0 1px 12px rgba(2, 6, 12, 0.5);
  }

  .entry-lead p:first-child {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.95;
    letter-spacing: 0.03em;
    color: var(--mist);
  }

  .entry-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 1px;
    margin: clamp(20px, 2.8vh, 28px) 0 0;
    border: 1px solid var(--line-soft);
    background: rgba(198, 226, 240, 0.09);
  }

  .entry-meta > div {
    padding: 11px 14px;
    background: rgba(6, 15, 26, 0.24);
  }

  .entry-meta dt {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--mist-3);
  }

  .entry-meta dd {
    margin-top: 5px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: var(--mist);
  }

  .entry-section {
    margin-top: clamp(26px, 3.8vh, 38px);
  }

  .entry-section h4 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.9rem;
    letter-spacing: 0.26em;
    color: var(--mist);
    text-shadow: 0 1px 14px rgba(2, 6, 12, 0.58);
  }

  .entry-section h4::before {
    content: '';
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border: 1px solid rgba(227, 206, 162, 0.7);
    transform: rotate(45deg);
  }

  .entry-section h4::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(198, 226, 240, 0.16), transparent);
  }

  .entry-section p {
    max-width: 74ch;
    font-size: 0.86rem;
    line-height: 1.95;
    color: var(--mist-2);
  }

  .entry-section p + p {
    margin-top: 10px;
  }

  .entry-list {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-list li {
    position: relative;
    max-width: 74ch;
    padding-left: 18px;
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--mist-2);
  }

  .entry-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.76em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(227, 206, 162, 0.72);
    box-shadow: 0 0 8px rgba(227, 206, 162, 0.35);
  }

  .entry-quote {
    margin: 16px 0 0;
    padding: 16px 22px;
    border-left: 1px solid rgba(227, 206, 162, 0.5);
    background: linear-gradient(90deg, rgba(227, 206, 162, 0.08), transparent 78%);
    font-family: var(--font-display);
    font-size: 0.94rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: #f0e6d2;
    text-shadow: 0 1px 16px rgba(2, 6, 12, 0.55);
  }

  .entry-quote + p {
    margin-top: 14px;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .entry-jump {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid rgba(198, 226, 240, 0.2);
    border-radius: 2px;
    background: rgba(230, 240, 247, 0.05);
    color: var(--mist-2);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      color 0.4s ease,
      border-color 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .entry-jump span {
    color: var(--glow);
    opacity: 0.7;
    transition:
      transform 0.4s cubic-bezier(0.16, 0.72, 0.22, 1),
      opacity 0.4s ease;
  }

  .entry-jump:hover,
  .entry-jump:focus-visible {
    color: var(--mist);
    border-color: rgba(159, 220, 238, 0.44);
    background: rgba(159, 220, 238, 0.07);
    box-shadow: 0 0 24px rgba(159, 220, 238, 0.08);
  }

  .entry-jump:hover span,
  .entry-jump:focus-visible span {
    transform: translateX(3px);
    opacity: 1;
  }

  .entry-jump:focus-visible {
    outline: 1px solid rgba(159, 220, 238, 0.6);
    outline-offset: 2px;
  }

  .squad-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
    gap: 10px;
  }

  .squad-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    padding: 14px;
    border: 1px solid rgba(198, 226, 240, 0.12);
    border-radius: 3px;
    background: rgba(230, 240, 247, 0.035);
  }

  .squad-card > img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    filter: invert(1) brightness(1.05) drop-shadow(0 6px 14px rgba(1, 4, 9, 0.5));
    opacity: 0.92;
  }

  .squad-glyph {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(227, 206, 162, 0.2);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(159, 220, 238, 0.08), transparent 72%);
    font-family: 'Ma Shan Zheng', var(--font-display);
    font-size: 1.25rem;
    color: rgba(227, 206, 162, 0.72);
  }

  .squad-card h5 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.86rem;
    letter-spacing: 0.14em;
    color: var(--mist);
  }

