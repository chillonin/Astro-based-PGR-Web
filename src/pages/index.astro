---
import BaseLayout from '../layouts/BaseLayout.astro';
import WikiPanel from '../components/WikiPanel.astro';
---

<BaseLayout
  title="梦之漪 · Dream Ripple"
  description="一个水做的梦。移动鼠标，让水面泛起涟漪；点击，唤醒沉在梦里的光。水面之下，还藏着一局扫雷。"
>
  <main class="stage" data-stage>
    <video
      class="sky"
      data-sky
      autoplay
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
    ></video>
    <canvas class="ripples" data-ripples aria-hidden="true"></canvas>
    <div class="wash" aria-hidden="true"></div>

    <div class="frame" data-frame>
      <header class="top">
        <p class="mark">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <path d="M3 14.4c3.1-3.9 6.4-5.9 9-5.9s5.9 2 9 5.9" opacity="0.34"></path>
            <path d="M5.6 17.4c2.3-2.9 4.5-4.4 6.4-4.4s4.1 1.5 6.4 4.4" opacity="0.62"></path>
            <path d="M9.2 20.2c1.1-1.3 2-1.9 2.8-1.9s1.7 0.6 2.8 1.9"></path>
          </svg>
          <span>霁梦</span>
        </p>

        <button class="sound" type="button" data-audio-toggle aria-pressed="false" aria-label="播放背景音乐">
          <span class="sound-label">声音</span>
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </button>
      </header>

      <section class="hero">
        <h1>梦之漪</h1>
        <p class="latin">dream ripple</p>
        <p class="poem">眠于厄寐，<br />苦厄澄我心镜；<br />生于灰烬，<br />渡你霁色之梦。</p>
      </section>

      <footer class="bottom">
        <div class="player">
          <button class="play" type="button" data-audio-toggle aria-pressed="false" aria-label="播放背景音乐">
            <svg class="icon-play" viewBox="0 0 10 12" width="10" height="12" aria-hidden="true">
              <path d="M0 0.6v10.8L9.4 6z" fill="currentColor"></path>
            </svg>
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          </button>
          <div class="player-body">
            <p class="track">她的梦<span>战双帕弥什 / Sawako 碎花</span></p>
            <div class="rail"><span class="fill" data-progress></span></div>
            <p class="time">
              <span data-current>00:00</span>
              <span class="slash">/</span>
              <span data-duration>00:00</span>
            </p>
          </div>
        </div>

        <button
          class="hint-toggle"
          type="button"
          data-game-toggle
          aria-expanded="false"
          aria-controls="ripple-game"
        >
          拨开水面
        </button>

        <p class="credits">影像　战双帕弥什 · 丽芙霁梦<br />音乐　她的梦 · Sawako 碎花</p>
      </footer>
    </div>

    <div class="library" id="game-library" data-library aria-hidden="true" inert>
      <section class="library-panel" role="dialog" aria-labelledby="library-question">
        <p class="library-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1">
            <path d="M3 14.4c3.1-3.9 6.4-5.9 9-5.9s5.9 2 9 5.9" opacity="0.34"></path>
            <path d="M5.6 17.4c2.3-2.9 4.5-4.4 6.4-4.4s4.1 1.5 6.4 4.4" opacity="0.62"></path>
            <path d="M9.2 20.2c1.1-1.3 2-1.9 2.8-1.9s1.7 0.6 2.8 1.9"></path>
          </svg>
        </p>
        <h2 class="library-question" id="library-question">
          欢迎指挥官来到灰鸦小队的小游戏库~<span>今天想玩什么？</span>
        </h2>

        <ul class="library-list">
          <li>
            <button class="library-item" type="button" data-library-game="lucia">
              <span class="library-portrait">
                <img src="/media/wiki/p-lucia.png" alt="" width="93" height="100" loading="lazy" />
              </span>
              <span class="library-copy">
                <span class="library-name">露门当然是玩阿呆蛙快跑~</span>
                <span class="library-latin">Lucia</span>
              </span>
            </button>
          </li>
          <li>
            <button class="library-item" type="button" data-library-game="lee">
              <span class="library-portrait">
                <img src="/media/wiki/p-lee.png" alt="" width="93" height="100" loading="lazy" />
              </span>
              <span class="library-copy">
                <span class="library-name">和火子哥玩超难游戏扫雷(bushi</span>
                <span class="library-latin">Lee</span>
              </span>
            </button>
          </li>
          <li>
            <button class="library-item" type="button" data-library-game="liv">
              <span class="library-portrait">
                <img src="/media/wiki/p-liv.png" alt="" width="112" height="100" loading="lazy" />
              </span>
              <span class="library-copy">
                <span class="library-name">芙头帮药丸飞机大战(雾)</span>
                <span class="library-latin">Liv</span>
              </span>
            </button>
          </li>
        </ul>

        <p class="library-note" data-library-note aria-live="polite"></p>
      </section>
    </div>

    <div class="game-layer" id="ripple-game" data-game-layer aria-hidden="true" inert>
      <section class="game-panel" aria-label="扫雷">
        <aside class="game-soul" aria-hidden="true">
          <div class="soul-portrait">
            <p class="soul-line" data-soul-line>在时间的尽头……湮灭吧！</p>
            <img class="soul-figure" src="/media/lee-stand.png" alt="" width="2000" height="3240" loading="lazy" />
            <p class="soul-badge"><span>里</span><small>LEE · 灰鸦小队</small></p>
          </div>
        </aside>

        <div class="game-core">
          <header class="panel-head">
            <div class="panel-title">
              <h3>扫雷</h3>
              <p class="panel-sub">水底埋着未说出口的梦</p>
            </div>
            <div class="panel-tools">
              <div class="counters">
                <p class="counter"><span>剩余</span><b data-mines-left>40</b></p>
                <p class="counter"><span>时间</span><b data-timer>00:00</b></p>
              </div>
              <span class="skill-hold">
                <button
                  class="skill"
                  type="button"
                  data-skill
                  aria-describedby="skill-tip"
                  aria-pressed="false"
                  aria-label="技能：点击任意格子后扫描 5×5 范围内的格子并点开其中无雷的格子"
                >
                  <img src="/media/skill-blade.png" alt="" width="75" height="75" />
                </button>
                <span class="skill-tip" id="skill-tip" role="tooltip">
                  技能：点击任意格子后扫描 5×5 范围内的格子并点开其中无雷的格子
                </span>
              </span>
            </div>
          </header>

          <div class="panel-controls">
            <label class="mine-range">
              <span>雷数</span>
              <input type="range" min="1" max="99" value="40" data-mine-range aria-label="雷数，1 到 99" />
              <b data-mine-count>40</b>
            </label>
            <div class="panel-actions">
              <div class="modes" role="group" aria-label="操作模式">
                <button type="button" class="mode is-active" data-mode="dig" aria-pressed="true">挖开</button>
                <button type="button" class="mode" data-mode="flag" aria-pressed="false">标记</button>
              </div>
              <button type="button" class="restart" data-restart>重新开始</button>
            </div>
          </div>

          <div class="board-wrap">
            <div class="board" data-board role="group" aria-label="30 乘 16 扫雷棋盘"></div>
          </div>

          <p class="panel-status" data-status>水很静，先从任意一格开始。</p>
        </div>
      </section>
    </div>

    <div class="runner-layer" id="frog-run" data-run-layer aria-hidden="true" inert>
      <section class="run-panel" aria-label="阿呆蛙快跑">
        <aside class="run-soul" aria-hidden="true">
          <div class="soul-portrait">
            <p class="soul-line" data-run-line>越过迷雾……与深渊！</p>
            <img class="soul-figure" src="/media/lucia-stand.png" alt="" width="1975" height="3200" loading="lazy" />
            <p class="soul-badge"><span>露西亚</span><small>LUCIA · 灰鸦小队</small></p>
          </div>
        </aside>

        <div class="run-core">
          <header class="panel-head">
            <div class="panel-title">
              <h3>阿呆蛙快跑</h3>
              <p class="panel-sub">空格起跳，Shift 下蹲 · 尖刺要跳过，倒刺要蹲下</p>
            </div>
            <div class="panel-tools">
              <div class="counters">
                <p class="counter"><span>距离</span><b data-run-score>0 m</b></p>
                <p class="counter"><span>最远</span><b data-run-best>0 m</b></p>
              </div>
              <span class="skill-hold">
                <button
                  class="skill"
                  type="button"
                  data-run-skill
                  aria-describedby="run-skill-tip"
                  aria-pressed="false"
                  aria-label="技能：清除屏幕中所有尖刺和倒刺"
                >
                  <img src="/media/lucia-blade.png" alt="" width="75" height="75" />
                  <span class="skill-cool" data-run-cool></span>
                </button>
                <span class="skill-tip" id="run-skill-tip" role="tooltip">技能：清除屏幕中所有尖刺和倒刺</span>
              </span>
            </div>
          </header>

          <div class="panel-controls">
            <label class="mine-range">
              <span>密度增速</span>
              <input
                type="range"
                min="0"
                max="30"
                step="1"
                value="12"
                data-run-density
                aria-label="尖刺与倒刺密度增速，每 10 秒的百分比"
              />
              <b data-run-density-value>+12%</b>
            </label>
            <span class="range-note">30 秒后开始增长 · 最高 ×3</span>
          </div>

          <div class="run-stage" data-run-stage>
            <canvas class="run-canvas" data-run-canvas aria-label="无尽跑道，尖刺与倒刺从右侧而来"></canvas>
            <div class="run-overlay" data-run-overlay>
              <p class="run-tip" data-run-tip>阿呆蛙在岸边热身，空格起跳。</p>
              <button class="run-start" type="button" data-run-start>开始奔跑</button>
            </div>
          </div>

          <p class="panel-status" data-run-status>水很静，跑道在前方。</p>
        </div>
      </section>
    </div>

    <div class="runner-layer plane-layer" id="liv-plane" data-plane-layer aria-hidden="true" inert>
      <section class="run-panel plane-panel" aria-label="飞机大战">
        <aside class="run-soul plane-soul" aria-hidden="true">
          <div class="plane-portrait">
            <img
              class="plane-figure"
              src="/media/liv-stand.png"
              alt=""
              width="2100"
              height="3400"
              loading="lazy"
            />
            <p class="soul-line" data-plane-line>以苦厄，澄我心镜！</p>
            <p class="soul-badge"><span>丽芙</span><small>LIV · 灰鸦小队</small></p>
          </div>
        </aside>

        <div class="run-core plane-core">
          <header class="panel-head">
            <div class="panel-title">
              <h3>飞机大战</h3>
              <p class="panel-sub">W / A / S / D 操控 · 自动射击 · 补给永久生效</p>
            </div>
            <div class="panel-tools">
              <div class="counters">
                <p class="counter"><span>战果</span><b data-plane-score>0</b></p>
                <p class="counter"><span>波次</span><b data-plane-wave>01</b></p>
              </div>
              <span class="skill-hold">
                <button
                  class="skill"
                  type="button"
                  data-plane-skill
                  aria-describedby="plane-skill-tip"
                  aria-pressed="false"
                  aria-label="技能：玩家飞机无敌10s且像八个方向发射高伤子弹"
                >
                  <span class="skill-cd-ring" data-plane-ring aria-hidden="true"></span>
                  <img src="/media/skill-crystal.png" alt="" width="75" height="75" />
                  <span class="skill-cool" data-plane-cool></span>
                </button>
                <span class="skill-tip" id="plane-skill-tip" role="tooltip">
                  技能：玩家飞机无敌10s且像八个方向发射高伤子弹
                </span>
              </span>
            </div>
          </header>

          <div class="plane-hud">
            <div class="plane-vitals">
              <span class="plane-hud-label">装甲</span>
              <div class="hp-pips" data-plane-hp>
                <img src="/media/hp-orb.png" alt="" width="75" height="75" />
                <img src="/media/hp-orb.png" alt="" width="75" height="75" />
                <img src="/media/hp-orb.png" alt="" width="75" height="75" />
              </div>
            </div>
            <ul class="plane-buffs">
              <li style="--buff: #e3cea2"><span>伤害</span><b data-buff-damage>1</b></li>
              <li style="--buff: #9fdcee"><span>射速</span><b data-buff-rate>1</b></li>
              <li style="--buff: #b9b0e8"><span>移速</span><b data-buff-speed>1</b></li>
              <li style="--buff: #9ad7c9"><span>弹道</span><b data-buff-multi>1</b></li>
            </ul>
          </div>

          <div class="panel-controls">
            <div class="range-group">
              <label class="mine-range">
                <span>敌速增幅</span>
                <input
                  type="range"
                  min="0"
                  max="10"
                  step="1"
                  value="3"
                  data-plane-speed
                  aria-label="敌机移速随波次增幅，每波的百分比"
                />
                <b data-plane-speed-value>+3%</b>
              </label>
              <label class="mine-range">
                <span>敌密增幅</span>
                <input
                  type="range"
                  min="0"
                  max="20"
                  step="1"
                  value="5"
                  data-plane-density
                  aria-label="敌机密度随波次增幅，每波的百分比"
                />
                <b data-plane-density-value>+5%</b>
              </label>
            </div>
            <span class="range-note">每波线性递增 · 移速最高 ×3 · 密度无上限</span>
          </div>

          <div class="plane-stage" data-plane-stage>
            <canvas class="plane-canvas" data-plane-canvas aria-label="垂直飞行射击战场"></canvas>
            <p class="plane-toast" data-plane-toast aria-live="polite"></p>
            <div class="run-overlay plane-overlay" data-plane-overlay>
              <p class="run-tip" data-plane-tip>W / A / S / D 操控战机 · 自动射击 · 拾取补给永久强化</p>
              <button class="run-start" type="button" data-plane-start>出击</button>
            </div>
          </div>

          <p class="panel-status" data-plane-status>丽芙的护航战机已经待命。</p>
        </div>
      </section>
    </div>

    <WikiPanel />

    <div class="gate" data-gate>
      <div class="gate-inner">
        <p class="gate-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="0.9">
            <path d="M3 14.4c3.1-3.9 6.4-5.9 9-5.9s5.9 2 9 5.9" opacity="0.34"></path>
            <path d="M5.6 17.4c2.3-2.9 4.5-4.4 6.4-4.4s4.1 1.5 6.4 4.4" opacity="0.62"></path>
            <path d="M9.2 20.2c1.1-1.3 2-1.9 2.8-1.9s1.7 0.6 2.8 1.9"></path>
          </svg>
        </p>
        <h2>梦之漪</h2>
        <p class="gate-latin">dream ripple</p>
        <p class="gate-line">水面记得每一次触碰</p>
        <div class="gate-enter">
          <div class="gate-load" data-gate-load>
            <p class="load-head">
              <span class="load-label" data-load-label>梦境正在浮现</span>
              <span class="load-pct" data-load-pct>0%</span>
            </p>
            <div
              class="load-rail"
              role="progressbar"
              aria-label="梦境载入进度"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              data-load-bar
            >
              <span class="load-fill" data-load-fill></span>
            </div>
          </div>
          <button class="enter" type="button" data-enter disabled>进入梦境</button>
        </div>
        <p class="gate-note" data-gate-note>影像与声音正在汇入梦境</p>
      </div>
    </div>

    <audio data-audio loop preload="none"></audio>
  </main>
</BaseLayout>

<script>
  import { initDream } from '../scripts/dream';
  import { initMinesweeper } from '../scripts/minesweeper';
  import { initRunner } from '../scripts/runner';
  import { initPlane } from '../scripts/plane';

  const runner = initRunner();
  const plane = initPlane();

  initDream();
  initMinesweeper(runner, plane);
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--night);
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s ease;
  }

  /* WebGL 接管后，视频只作为纹理来源 */
  .stage.is-shader .sky {
    opacity: 0;
  }

  .ripples {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(115% 85% at 50% 48%, rgba(4, 9, 16, 0) 38%, rgba(4, 9, 16, 0.62) 100%),
      linear-gradient(90deg, rgba(4, 9, 16, 0.74) 0%, rgba(4, 9, 16, 0.32) 30%, rgba(4, 9, 16, 0) 56%),
      linear-gradient(0deg, rgba(4, 9, 16, 0.8) 0%, rgba(4, 9, 16, 0) 36%),
      linear-gradient(180deg, rgba(4, 9, 16, 0.42) 0%, rgba(4, 9, 16, 0) 22%);
  }

  .frame {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(18px, 3vw, 38px) clamp(20px, 4vw, 58px) clamp(20px, 3.2vw, 42px);
  }

  /* ---- 顶部 ---- */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--mist-2);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.82rem;
    letter-spacing: 0.34em;
    opacity: 0;
    transition: opacity 1.4s ease 0.5s;
  }

  .mark svg {
    color: var(--glow);
    opacity: 0.75;
  }

  .sound {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 8px 15px;
    border: 1px solid rgba(230, 240, 247, 0.18);
    border-radius: 999px;
    color: var(--mist-2);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 1.4s ease 0.5s, border-color 0.4s ease, color 0.4s ease, background 0.4s ease;
  }

  .sound:hover {
    border-color: rgba(230, 240, 247, 0.42);
    color: var(--mist);
    background: rgba(230, 240, 247, 0.05);
  }

  .eq {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 12px;
  }

  .eq i {
    display: block;
    width: 1.5px;
    height: 3px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.7;
    transform-origin: center;
  }

  .eq i:nth-child(1) {
    height: 5px;
  }

  .eq i:nth-child(2) {
    height: 9px;
  }

  .eq i:nth-child(3) {
    height: 6px;
  }

  .eq i:nth-child(4) {
    height: 4px;
  }

  .stage.is-playing .eq i {
    animation: eq 0.9s ease-in-out infinite;
  }

  .stage.is-playing .eq i:nth-child(2) {
    animation-delay: -0.35s;
  }

  .stage.is-playing .eq i:nth-child(3) {
    animation-delay: -0.6s;
  }

  .stage.is-playing .eq i:nth-child(4) {
    animation-delay: -0.15s;
  }

  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.5);
      opacity: 0.55;
    }

    50% {
      transform: scaleY(1.35);
      opacity: 1;
    }
  }

  /* ---- 主视觉 ---- */
  .hero {
    align-self: center;
    max-width: 34rem;
    margin-left: clamp(0px, 3.4vw, 46px);
    transform: translate3d(calc(var(--px, 0) * 9px), calc(var(--py, 0) * 9px), 0);
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero > * {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(7px);
    transition:
      opacity 1.3s ease,
      transform 1.4s cubic-bezier(0.16, 0.72, 0.22, 1),
      filter 1.4s ease;
  }

  .hero {
    transition:
      transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.6s ease;
  }

  /* 打开水底棋局时，让出画面中心，标题与短诗退到水下 */
  .stage.is-game .hero {
    opacity: 0;
    pointer-events: none;
  }

  /* 打开 WIKI 时，原界面只留下背景音乐按钮与右侧箭头 */
  .stage.is-wiki .hero,
  .stage.is-wiki .mark,
  .stage.is-wiki .bottom {
    opacity: 0;
    pointer-events: none;
  }

  .stage.is-wiki .hero {
    transition: opacity 0.55s ease;
  }

  .stage.is-wiki .bottom {
    transition: opacity 0.55s ease;
  }

  .stage.is-entered .hero h1 {
    opacity: 1;
    transform: none;
    filter: none;
    transition-delay: 0.1s;
  }

  .stage.is-entered .hero .latin {
    opacity: 1;
    transform: none;
    filter: none;
    transition-delay: 0.3s;
  }

  .stage.is-entered .hero .poem {
    opacity: 1;
    transform: none;
    filter: none;
    transition-delay: 0.44s;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(3.5rem, 9.6vw, 8.6rem);
    line-height: 1;
    letter-spacing: 0.12em;
    margin-left: -0.06em;
    color: var(--mist);
    text-shadow:
      0 0 42px rgba(140, 208, 232, 0.32),
      0 0 120px rgba(120, 190, 220, 0.18);
  }

  .latin {
    margin-top: clamp(12px, 1.6vh, 20px);
    font-family: var(--font-latin);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    letter-spacing: 0.46em;
    color: var(--mist);
    opacity: 0.9;
    text-shadow: 0 1px 20px rgba(4, 9, 16, 0.6);
  }

  .poem {
    margin-top: clamp(26px, 4.5vh, 48px);
    padding-left: 18px;
    border-left: 1px solid rgba(227, 206, 162, 0.5);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    line-height: 2.1;
    color: #cfe1ed;
    letter-spacing: 0.04em;
    text-shadow: 0 1px 22px rgba(4, 9, 16, 0.65);
  }

  /* ---- 底部 ---- */
  .bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 26px;
    opacity: 0;
    transition: opacity 1.6s ease 0.75s;
  }

  .stage.is-entered .top,
  .stage.is-entered .mark,
  .stage.is-entered .sound,
  .stage.is-entered .bottom {
    opacity: 1;
  }

  .player {
    display: flex;
    align-items: center;
    gap: 15px;
    justify-self: start;
  }

  .play {
    width: 46px;
    height: 46px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid rgba(230, 240, 247, 0.32);
    border-radius: 50%;
    color: var(--mist);
    background: rgba(8, 18, 30, 0.22);
    backdrop-filter: blur(5px);
    transition: border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
  }

  .play:hover {
    border-color: rgba(230, 240, 247, 0.7);
    background: rgba(159, 220, 238, 0.08);
    box-shadow: 0 0 26px rgba(140, 208, 232, 0.18);
  }

  .play .eq {
    display: none;
  }

  .play .eq i {
    width: 2px;
    background: var(--mist);
  }

  .stage.is-playing .play .icon-play {
    display: none;
  }

  .stage.is-playing .play .eq {
    display: flex;
  }

  .player-body {
    min-width: clamp(170px, 20vw, 250px);
  }

  .track {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: var(--mist);
    text-shadow: 0 1px 16px rgba(4, 9, 16, 0.7);
  }

  .track span {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--mist-3);
  }

  .rail {
    position: relative;
    height: 1px;
    margin: 9px 0 7px;
    background: rgba(198, 226, 240, 0.2);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: linear-gradient(90deg, rgba(159, 220, 238, 0.5), var(--mist));
  }

  .time {
    display: flex;
    gap: 6px;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--mist-3);
    font-variant-numeric: tabular-nums;
  }

  .slash {
    opacity: 0.5;
  }

  .hint-toggle {
    justify-self: center;
    align-self: end;
    padding: 11px 27px;
    border: 1px solid rgba(230, 240, 247, 0.22);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.76rem;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    white-space: nowrap;
    color: var(--mist-2);
    background: rgba(6, 14, 24, 0.16);
    backdrop-filter: blur(5px);
    transition: color 0.4s ease, border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
  }

  .hint-toggle:hover {
    color: var(--mist);
    border-color: rgba(159, 220, 238, 0.55);
    background: rgba(159, 220, 238, 0.06);
    box-shadow: 0 0 32px rgba(140, 208, 232, 0.16);
  }

  .hint-toggle[aria-expanded='true'] {
    color: var(--mist);
    border-color: rgba(159, 220, 238, 0.62);
    background: rgba(159, 220, 238, 0.08);
    box-shadow: 0 0 34px rgba(140, 208, 232, 0.2);
  }

  .credits {
    justify-self: end;
    text-align: right;
    font-size: 0.68rem;
    line-height: 2;
    letter-spacing: 0.08em;
    color: var(--mist-2);
    opacity: 0.72;
    text-shadow: 0 1px 16px rgba(4, 9, 16, 0.7);
  }

  /* ---- 水面之下的扫雷 ---- */
  .game-layer,
  .runner-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    padding: clamp(74px, 10vh, 104px) clamp(70px, 6vw, 88px) clamp(120px, 16vh, 168px);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.55s ease, visibility 0.55s ease;
  }

  .game-layer.is-open,
  .runner-layer.is-open {
    opacity: 1;
    visibility: visible;
  }

  .game-panel,
  .run-panel {
    pointer-events: auto;
    width: 100%;
    max-width: 980px;
    max-height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(16px, 2vw, 24px);
    padding: 20px 22px 18px;
    border: 1px solid rgba(198, 226, 240, 0.16);
    border-radius: 4px;
    background: rgba(6, 14, 24, 0.56);
    backdrop-filter: blur(16px) saturate(0.85);
    box-shadow:
      0 34px 90px rgba(2, 6, 12, 0.5),
      inset 0 1px 0 rgba(230, 240, 247, 0.07);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.18, 0.72, 0.22, 1);
  }

  .game-layer.is-open .game-panel,
  .runner-layer.is-open .run-panel {
    opacity: 1;
    transform: none;
  }

  .game-core,
  .run-core {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* 左侧的里：立在面板内，像被水底的光托住 */
  .game-soul,
  .run-soul {
    position: relative;
    width: clamp(112px, 11.6vw, 168px);
    padding-right: clamp(8px, 1vw, 14px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    isolation: isolate;
  }

  .game-soul::before,
  .run-soul::before {
    content: '';
    position: absolute;
    inset: 8% 0 0;
    z-index: -1;
    background: radial-gradient(62% 54% at 50% 78%, rgba(159, 220, 238, 0.16), transparent 72%);
    filter: blur(8px);
  }

  .game-soul::after,
  .run-soul::after {
    content: '';
    position: absolute;
    top: 3%;
    bottom: 3%;
    right: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(198, 226, 240, 0.18) 20%,
      rgba(198, 226, 240, 0.18) 80%,
      transparent
    );
  }

  .soul-portrait {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
  }

  .soul-figure {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter:
      drop-shadow(0 0 1px rgba(230, 240, 247, 0.55))
      drop-shadow(0 10px 24px rgba(2, 6, 12, 0.6))
      saturate(0.96);
    opacity: 0.94;
    -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 82%, transparent 100%);
  }

  .soul-line {
    position: absolute;
    bottom: calc(100% - 20px);
    left: 2px;
    z-index: 3;
    width: max-content;
    max-width: 210px;
    padding: 9px 14px;
    border: 1px solid rgba(227, 206, 162, 0.34);
    border-radius: 3px;
    background: rgba(6, 14, 24, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 34px rgba(2, 6, 12, 0.5);
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    line-height: 1.75;
    color: #f1e7d0;
    opacity: 0;
    visibility: hidden;
    transform: translate(-6px, 5px);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 0.72, 0.22, 1),
      visibility 0.35s;
  }

  .soul-line::after {
    content: '';
    position: absolute;
    left: 20px;
    bottom: -5px;
    width: 8px;
    height: 8px;
    border-right: 1px solid rgba(227, 206, 162, 0.34);
    border-bottom: 1px solid rgba(227, 206, 162, 0.34);
    background: rgba(6, 14, 24, 0.9);
    transform: rotate(45deg);
  }

  .soul-line.is-saying {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* ---- 小游戏库：中央的询问界面 ---- */
  .library {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-items: center;
    padding: clamp(74px, 10vh, 104px) 20px clamp(120px, 16vh, 168px);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .library.is-open {
    opacity: 1;
    visibility: visible;
  }

  .library-panel {
    pointer-events: auto;
    width: min(548px, 100%);
    padding: clamp(24px, 3.4vh, 36px) clamp(24px, 3vw, 40px) clamp(18px, 2.4vh, 24px);
    border: 1px solid rgba(198, 226, 240, 0.18);
    border-radius: 22px;
    background:
      radial-gradient(120% 92% at 14% 0%, rgba(159, 220, 238, 0.1), transparent 58%),
      radial-gradient(90% 70% at 100% 100%, rgba(227, 206, 162, 0.05), transparent 62%),
      linear-gradient(180deg, rgba(226, 241, 250, 0.05), rgba(4, 10, 18, 0.08)),
      rgba(6, 15, 26, 0.54);
    backdrop-filter: blur(18px) saturate(0.9);
    box-shadow:
      0 36px 96px rgba(2, 6, 12, 0.52),
      inset 0 1px 0 rgba(230, 240, 247, 0.08);
    opacity: 0;
    transform: translateY(12px) scale(0.988);
    transition: opacity 0.6s ease, transform 0.75s cubic-bezier(0.18, 0.72, 0.22, 1);
  }

  .library.is-open .library-panel {
    opacity: 1;
    transform: none;
  }

  .library-mark {
    margin-bottom: 15px;
    color: var(--glow);
    opacity: 0.55;
  }

  .library-question {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 2.05;
    letter-spacing: 0.06em;
    color: var(--mist);
    text-shadow: 0 1px 18px rgba(4, 9, 16, 0.6);
  }

  .library-question span {
    display: block;
  }

  .library-list {
    margin: clamp(18px, 2.6vh, 26px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .library-list li {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.55s cubic-bezier(0.18, 0.72, 0.22, 1);
  }

  .library.is-open .library-list li {
    opacity: 1;
    transform: none;
  }

  .library.is-open .library-list li:nth-child(1) {
    transition-delay: 0.12s;
  }

  .library.is-open .library-list li:nth-child(2) {
    transition-delay: 0.19s;
  }

  .library.is-open .library-list li:nth-child(3) {
    transition-delay: 0.26s;
  }

  .library-item {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
    padding: 12px 10px 12px 4px;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    color: var(--mist-2);
    transition:
      color 0.4s ease,
      padding 0.5s cubic-bezier(0.18, 0.72, 0.22, 1),
      background 0.5s ease;
  }

  .library-list li:last-child .library-item {
    border-bottom: 0;
  }

  .library-item:hover,
  .library-item:focus-visible {
    padding-left: 11px;
    background: linear-gradient(90deg, rgba(159, 220, 238, 0.08), transparent 72%);
  }

  .library-portrait {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(227, 206, 162, 0.24);
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 42%, rgba(159, 220, 238, 0.12), rgba(4, 10, 18, 0.3) 72%);
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .library-portrait img {
    width: 38px;
    height: 44px;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.94) contrast(1.02);
  }

  .library-item:hover .library-portrait,
  .library-item:focus-visible .library-portrait {
    border-color: rgba(227, 206, 162, 0.6);
    box-shadow: 0 0 22px rgba(140, 208, 232, 0.18);
  }

  .library-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .library-name {
    font-family: var(--font-display);
    font-size: 0.94rem;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--mist-2);
    transition: color 0.4s ease;
  }

  .library-item:hover .library-name,
  .library-item:focus-visible .library-name {
    color: var(--mist);
  }

  .library-latin {
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--mist-3);
  }

  .library-note {
    min-height: 1.4em;
    margin-top: 13px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--gold);
    opacity: 0.9;
  }

  .panel-tools {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .skill-hold {
    position: relative;
    display: grid;
    place-items: center;
  }

  .skill {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(198, 226, 240, 0.22);
    border-radius: 50%;
    background: rgba(8, 18, 30, 0.35);
    backdrop-filter: blur(6px);
    transition:
      border-color 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease,
      opacity 0.4s ease;
  }

  .skill img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    filter: brightness(0) invert(0.9) drop-shadow(0 0 6px rgba(159, 220, 238, 0.35));
    opacity: 0.86;
    transition: filter 0.4s ease, opacity 0.4s ease;
  }

  .skill:hover {
    border-color: rgba(159, 220, 238, 0.55);
    background: rgba(159, 220, 238, 0.07);
    box-shadow: 0 0 24px rgba(140, 208, 232, 0.22);
  }

  .skill.is-armed {
    border-color: rgba(227, 206, 162, 0.72);
    background: rgba(227, 206, 162, 0.1);
    box-shadow: 0 0 30px rgba(227, 206, 162, 0.3);
  }

  .skill.is-armed img {
    filter: brightness(0) invert(0.96) drop-shadow(0 0 8px rgba(227, 206, 162, 0.65));
    opacity: 1;
  }

  .skill.is-armed::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid rgba(227, 206, 162, 0.3);
    border-radius: 50%;
    animation: skill-pulse 1.8s ease-in-out infinite;
  }

  @keyframes skill-pulse {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(0.94);
    }

    50% {
      opacity: 0.7;
      transform: scale(1.04);
    }
  }

  .skill.is-spent {
    opacity: 0.34;
    cursor: default;
  }

  .skill.is-spent:hover {
    border-color: rgba(198, 226, 240, 0.22);
    background: rgba(8, 18, 30, 0.35);
    box-shadow: none;
  }

  .skill-tip {
    position: absolute;
    top: calc(100% + 12px);
    right: -6px;
    z-index: 6;
    width: 248px;
    padding: 10px 13px;
    border: 1px solid rgba(198, 226, 240, 0.22);
    border-radius: 4px;
    background: rgba(5, 12, 21, 0.94);
    box-shadow: 0 18px 42px rgba(2, 6, 12, 0.55);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    line-height: 1.85;
    color: var(--mist-2);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s ease, visibility 0.35s;
  }

  .skill-hold:hover .skill-tip,
  .skill-hold:focus-within .skill-tip {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* ---- 阿呆蛙快跑 ---- */
  .run-soul {
    width: clamp(130px, 13.6vw, 196px);
  }

  .run-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: clamp(230px, 34vh, 330px);
    overflow: hidden;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background:
      radial-gradient(80% 120% at 8% 100%, rgba(159, 220, 238, 0.09), transparent 60%),
      rgba(3, 8, 16, 0.32);
  }

  .run-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .run-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 18px;
    background: radial-gradient(72% 92% at 50% 45%, rgba(4, 10, 18, 0.4), rgba(3, 7, 12, 0.78));
    backdrop-filter: blur(2px);
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }

  .run-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .run-tip {
    font-family: var(--font-display);
    font-size: 0.84rem;
    letter-spacing: 0.12em;
    line-height: 1.9;
    color: var(--mist);
    text-align: center;
    text-shadow: 0 1px 18px rgba(2, 6, 12, 0.7);
  }

  .run-start {
    padding: 10px 30px;
    border: 1px solid rgba(230, 240, 247, 0.34);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--mist);
    background: rgba(8, 18, 30, 0.3);
    backdrop-filter: blur(6px);
    transition:
      border-color 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .run-start:hover,
  .run-start:focus-visible {
    border-color: rgba(230, 240, 247, 0.78);
    background: rgba(159, 220, 238, 0.08);
    box-shadow: 0 0 34px rgba(140, 208, 232, 0.22);
  }

  .skill {
    position: relative;
  }

  .skill-cool {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--mist);
    opacity: 0;
    transition: opacity 0.3s ease;
    font-variant-numeric: tabular-nums;
  }

  .skill.is-cooling img {
    opacity: 0.2;
    filter: brightness(0) invert(0.72);
  }

  .skill.is-cooling .skill-cool {
    opacity: 0.92;
  }

  .skill.is-locked {
    opacity: 0.42;
  }

  /* ---- 飞机大战 ---- */
  .plane-panel {
    max-width: 1080px;
  }

  .plane-soul {
    width: clamp(150px, 16vw, 214px);
    padding-right: clamp(10px, 1.2vw, 16px);
  }

  .plane-portrait {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    isolation: isolate;
  }

  .plane-portrait::before {
    content: '';
    position: absolute;
    inset: 8% 0 0;
    z-index: -1;
    background: radial-gradient(62% 54% at 50% 78%, rgba(159, 220, 238, 0.16), transparent 72%);
    filter: blur(8px);
  }

  .plane-figure {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter:
      drop-shadow(0 0 1px rgba(230, 240, 247, 0.55))
      drop-shadow(0 10px 24px rgba(2, 6, 12, 0.6))
      saturate(0.96);
    opacity: 0.96;
    -webkit-mask-image: linear-gradient(180deg, #000 84%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 84%, transparent 100%);
  }

  .soul-badge {
    position: absolute;
    right: 10px;
    bottom: 11px;
    left: 10px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-shadow: 0 1px 14px rgba(4, 10, 18, 0.8);
  }

  .soul-badge span {
    font-family: var(--font-display);
    font-size: 0.88rem;
    letter-spacing: 0.18em;
    color: var(--mist);
  }

  .soul-badge small {
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    color: var(--mist-3);
  }

  .plane-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
  }

  .plane-vitals {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .plane-hud-label {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--mist-3);
  }

  .hp-pips {
    display: flex;
    gap: 7px;
  }

  .hp-pips img {
    display: block;
    width: 18px;
    height: 18px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(159, 220, 238, 0.65));
    transition: filter 0.35s ease, opacity 0.35s ease;
  }

  .hp-pips img.is-lost {
    filter: grayscale(1) brightness(0.7);
    opacity: 0.26;
  }

  .plane-buffs {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plane-buffs li {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid rgba(198, 226, 240, 0.13);
    border-radius: 999px;
    background: rgba(8, 18, 30, 0.32);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--mist-3);
  }

  .plane-buffs li span {
    color: var(--mist-3);
  }

  .plane-buffs li b {
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--buff, var(--mist));
    font-variant-numeric: tabular-nums;
  }

  .plane-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: clamp(280px, 46vh, 440px);
    overflow: hidden;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background:
      radial-gradient(80% 70% at 22% 12%, rgba(217, 139, 156, 0.06), transparent 62%),
      rgba(3, 8, 16, 0.42);
  }

  .plane-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plane-overlay {
    background: radial-gradient(70% 90% at 50% 46%, rgba(4, 10, 18, 0.32), rgba(3, 7, 12, 0.82));
  }

  .plane-toast {
    position: absolute;
    top: 16px;
    left: 50%;
    z-index: 3;
    padding: 6px 16px;
    border: 1px solid rgba(198, 226, 240, 0.22);
    border-radius: 999px;
    background: rgba(5, 12, 21, 0.86);
    backdrop-filter: blur(8px);
    box-shadow: 0 12px 30px rgba(2, 6, 12, 0.5);
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.18, 0.72, 0.22, 1), visibility 0.3s;
  }

  .plane-toast.is-show {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .plane-panel .skill img {
    width: 27px;
    height: 27px;
    filter: drop-shadow(0 0 6px rgba(159, 220, 238, 0.5));
    opacity: 0.95;
  }

  .plane-panel .skill.is-cooling img {
    opacity: 0.22;
    filter: grayscale(0.5) brightness(0.7);
  }

  .skill-cd-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: conic-gradient(rgba(159, 220, 238, 0.72) var(--cd, 0deg), rgba(159, 220, 238, 0.05) 0);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .plane-panel .skill.is-cooling .skill-cd-ring {
    opacity: 1;
  }

  .plane-panel .skill.is-casting {
    border-color: rgba(227, 206, 162, 0.75);
    background: rgba(227, 206, 162, 0.1);
    box-shadow: 0 0 30px rgba(227, 206, 162, 0.35);
  }

  .plane-panel .skill.is-casting::after {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px solid rgba(227, 206, 162, 0.4);
    border-radius: 50%;
    animation: skill-pulse 1.4s ease-in-out infinite;
    pointer-events: none;
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .panel-title h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.02rem;
    letter-spacing: 0.32em;
    color: var(--mist);
  }

  .panel-sub {
    margin-top: 5px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--mist-3);
  }

  .counters {
    display: flex;
    gap: 20px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .counter {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--mist-3);
  }

  .counter b {
    font-weight: 400;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    color: var(--mist);
  }

  .panel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .mine-range {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--mist-3);
  }

  .mine-range b {
    min-width: 2ch;
    text-align: right;
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--mist);
    font-variant-numeric: tabular-nums;
  }

  .range-note {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--mist-3);
    opacity: 0.78;
  }

  .range-group {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 22px);
    flex-wrap: wrap;
  }

  .mine-range input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: clamp(90px, 12vw, 150px);
    height: 14px;
    background: transparent;
    cursor: pointer;
  }

  .mine-range input[type='range']::-webkit-slider-runnable-track {
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(159, 220, 238, 0.75) 0%,
      rgba(159, 220, 238, 0.75) var(--p, 20%),
      rgba(198, 226, 240, 0.18) var(--p, 20%)
    );
  }

  .mine-range input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: var(--mist);
    box-shadow: 0 0 12px rgba(159, 220, 238, 0.6);
  }

  .mine-range input[type='range']::-moz-range-track {
    height: 1px;
    background: rgba(198, 226, 240, 0.18);
  }

  .mine-range input[type='range']::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--mist);
    box-shadow: 0 0 12px rgba(159, 220, 238, 0.6);
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .modes {
    display: flex;
    gap: 4px;
  }

  .mode {
    padding: 4px 9px;
    border-bottom: 1px solid transparent;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--mist-3);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .mode:hover {
    color: var(--mist-2);
  }

  .mode.is-active {
    color: var(--mist);
    border-color: rgba(198, 226, 240, 0.5);
  }

  .restart {
    padding: 6px 16px;
    border: 1px solid rgba(198, 226, 240, 0.22);
    border-radius: 999px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--mist-2);
    transition: color 0.35s ease, border-color 0.35s ease, background 0.35s ease;
  }

  .restart:hover {
    color: var(--mist);
    border-color: rgba(159, 220, 238, 0.5);
    background: rgba(159, 220, 238, 0.06);
  }

  .board-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: 2px;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .board-wrap::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }

  .board-wrap::-webkit-scrollbar-thumb {
    background: rgba(198, 226, 240, 0.24);
  }

  .board {
    --cell: clamp(15px, 1.5vw, 21px);
    display: grid;
    grid-template-columns: repeat(30, var(--cell));
    gap: 2px;
    width: max-content;
    margin: 6px auto;
  }

  /* 格子由脚本动态生成，使用 :global 让作用域样式生效 */
  :global(.cell) {
    position: relative;
    width: var(--cell);
    height: var(--cell);
    display: grid;
    place-items: center;
    border: 1px solid rgba(198, 226, 240, 0.16);
    border-radius: 2px;
    background: rgba(190, 225, 240, 0.09);
    color: var(--mist-2);
    font-family: var(--font-ui);
    font-size: calc(var(--cell) * 0.6);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  :global(.cell:hover) {
    background: rgba(159, 220, 238, 0.2);
    border-color: rgba(159, 220, 238, 0.4);
  }

  :global(.cell.is-open),
  :global(.cell.is-open:hover) {
    background: rgba(4, 11, 20, 0.3);
    border-color: rgba(198, 226, 240, 0.06);
    cursor: default;
  }

  :global(.cell.is-flagged) {
    background: rgba(227, 206, 162, 0.08);
    border-color: rgba(227, 206, 162, 0.24);
  }

  :global(.cell.is-flagged::after) {
    content: '';
    width: 34%;
    height: 34%;
    background: var(--gold);
    transform: rotate(45deg);
    box-shadow: 0 0 8px rgba(227, 206, 162, 0.45);
  }

  :global(.cell.is-mine),
  :global(.cell.is-mine:hover) {
    background: rgba(210, 120, 142, 0.2);
    border-color: rgba(210, 120, 142, 0.35);
  }

  :global(.cell.is-mine::after) {
    content: '';
    width: 36%;
    height: 36%;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #ffe9ef, #d98b9c 62%, #8d4a58);
    box-shadow: 0 0 9px rgba(217, 139, 156, 0.6);
  }

  :global(.cell.is-wrong) {
    border-color: rgba(210, 120, 142, 0.5);
  }

  :global(.cell.is-wrong::after) {
    background: rgba(210, 120, 142, 0.85);
    box-shadow: none;
  }

  :global(.cell[data-n='1']) {
    color: #a9dcf0;
  }

  :global(.cell[data-n='2']) {
    color: #e6d3a6;
  }

  :global(.cell[data-n='3']) {
    color: #d9a8b6;
  }

  :global(.cell[data-n='4']) {
    color: #b9b0e8;
  }

  :global(.cell[data-n='5']) {
    color: #e0b48f;
  }

  :global(.cell[data-n='6']) {
    color: #9ad7c9;
  }

  :global(.cell[data-n='7']) {
    color: #c9d7e4;
  }

  :global(.cell[data-n='8']) {
    color: #8f9fb0;
  }

  .panel-status {
    min-height: 1.4em;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--mist-3);
    transition: color 0.4s ease;
  }

  .panel-status[data-state='win'] {
    color: var(--gold);
  }

  .panel-status[data-state='lose'] {
    color: #d9a3b0;
  }

  /* ---- 入场门 ---- */
  .gate {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: 24px;
    background: radial-gradient(78% 66% at 50% 45%, rgba(6, 14, 24, 0.5), rgba(3, 7, 12, 0.92));
    backdrop-filter: blur(3px);
    transition: opacity 1.1s ease, visibility 1.1s ease;
  }

  .stage.is-entered .gate {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .gate-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .gate-mark {
    color: var(--glow);
    opacity: 0.6;
    margin-bottom: 26px;
    animation: breathe 7s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.4;
      transform: translateY(0);
    }

    50% {
      opacity: 0.78;
      transform: translateY(-3px);
    }
  }

  .gate h2 {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(2.9rem, 7vw, 4.8rem);
    letter-spacing: 0.2em;
    margin-left: 0.2em;
    text-shadow: 0 0 60px rgba(140, 208, 232, 0.3);
  }

  .gate-latin {
    margin-top: 8px;
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.92rem;
    letter-spacing: 0.55em;
    color: var(--mist-2);
    opacity: 0.8;
  }

  .gate-line {
    margin-top: 30px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    color: var(--mist-2);
    opacity: 0.92;
  }

  /* ---- 入场载入进度 ---- */
  .gate-enter {
    display: grid;
    place-items: center;
    width: min(322px, 74vw);
    margin-top: 40px;
  }

  .gate-load {
    grid-area: 1 / 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 11px;
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.18, 0.72, 0.22, 1),
      visibility 0.5s ease;
  }

  .gate.is-ready .gate-load {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-7px);
  }

  .load-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--mist-2);
  }

  .load-pct {
    font-family: var(--font-latin);
    font-style: italic;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--mist);
    opacity: 0.88;
    font-variant-numeric: tabular-nums;
  }

  .load-rail {
    position: relative;
    height: 1px;
    background: rgba(198, 226, 240, 0.2);
  }

  .load-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: linear-gradient(90deg, rgba(159, 220, 238, 0.28), rgba(207, 235, 245, 0.92));
    box-shadow: 0 0 12px rgba(159, 220, 238, 0.45);
    transition: width 0.4s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .load-fill::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--mist);
    transform: translateY(-50%);
    box-shadow: 0 0 10px rgba(159, 220, 238, 0.85);
  }

  /* 服务器未提供文件大小时，用缓慢流动的光条表示仍在推进 */
  .gate-load.is-indeterminate .load-fill {
    width: 32%;
    transition: none;
    animation: load-drift 1.9s ease-in-out infinite;
  }

  .gate-load.is-indeterminate .load-fill::after {
    opacity: 0;
  }

  @keyframes load-drift {
    0% {
      transform: translateX(-110%);
    }

    100% {
      transform: translateX(340%);
    }
  }

  .enter {
    grid-area: 1 / 1;
    padding: 14px 42px;
    border: 1px solid rgba(230, 240, 247, 0.36);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    color: var(--mist);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(7px);
    transition:
      opacity 0.55s ease,
      transform 0.7s cubic-bezier(0.18, 0.72, 0.22, 1),
      visibility 0.55s ease,
      border-color 0.5s ease,
      background 0.5s ease,
      box-shadow 0.5s ease,
      letter-spacing 0.6s ease;
  }

  .gate.is-ready .enter {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .enter:hover {
    border-color: rgba(230, 240, 247, 0.8);
    background: rgba(159, 220, 238, 0.08);
    box-shadow: 0 0 40px rgba(140, 208, 232, 0.22);
    letter-spacing: 0.44em;
    text-indent: 0.44em;
  }

  .gate-note {
    margin-top: 20px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--mist-2);
    opacity: 0.7;
  }

  /* ---- 窄屏 ---- */
  @media (max-width: 860px) {
    .game-panel,
    .run-panel {
      grid-template-columns: minmax(0, 1fr);
      max-width: 760px;
    }

    .game-soul,
    .run-soul {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .frame {
      padding: 18px 20px calc(22px + env(safe-area-inset-bottom));
    }

    .wash {
      background:
        linear-gradient(0deg, rgba(4, 9, 16, 0.9) 0%, rgba(4, 9, 16, 0.1) 46%),
        linear-gradient(90deg, rgba(4, 9, 16, 0.62) 0%, rgba(4, 9, 16, 0.12) 78%),
        linear-gradient(180deg, rgba(4, 9, 16, 0.5) 0%, rgba(4, 9, 16, 0) 24%);
    }

    .hero {
      margin-left: 0;
      max-width: 100%;
    }

    h1 {
      font-size: clamp(3.2rem, 16vw, 4.6rem);
    }

    .poem {
      margin-top: 26px;
      font-size: 0.9rem;
    }

    .bottom {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .player {
      width: 100%;
    }

    .player-body {
      flex: 1;
      min-width: 0;
    }

    .track {
      display: block;
    }

    .track span {
      display: block;
      margin-top: 2px;
    }

    .hint-toggle {
      justify-self: center;
      padding: 10px 22px;
      font-size: 0.72rem;
    }

    .credits {
      justify-self: start;
      text-align: left;
    }

    .sound {
      padding: 9px 13px;
    }

    .game-layer {
      padding: 70px 12px 200px;
    }

    .game-panel,
    .run-panel {
      padding: 16px 14px 14px;
      gap: 12px;
    }

    .run-stage {
      height: clamp(200px, 38vh, 290px);
    }

    .plane-stage {
      height: clamp(200px, 32vh, 250px);
    }

    .plane-buffs li {
      padding: 2px 7px;
      font-size: 0.56rem;
    }

    .plane-toast {
      font-size: 0.66rem;
      letter-spacing: 0.08em;
    }

    .run-tip {
      font-size: 0.78rem;
    }

    .library {
      padding: 66px 12px 196px;
    }

    .library-panel {
      padding: 22px 18px 16px;
      border-radius: 18px;
    }

    .library-question {
      font-size: 0.95rem;
      line-height: 1.95;
    }

    .library-name {
      font-size: 0.86rem;
    }

    .skill-tip {
      width: 214px;
      right: -4px;
    }

    .panel-title h3 {
      font-size: 0.92rem;
    }

    .panel-sub {
      display: none;
    }

    .counters {
      gap: 14px;
    }

    .panel-controls {
      gap: 10px;
    }

    .mine-range input[type='range'] {
      width: 84px;
    }

    .panel-status {
      font-size: 0.66rem;
    }
  }

  @media (max-height: 660px) {
    h1 {
      font-size: clamp(2.7rem, 7vw, 4rem);
    }

    .poem {
      margin-top: 20px;
    }

    .gate-mark {
